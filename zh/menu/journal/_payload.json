[{"data":1,"prerenderedAt":154},["Reactive",2],{"content-query-lEXAvbkDhp":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"body":9,"_type":149,"_id":150,"_source":151,"_file":152,"_extension":153},"/zh/menu/journal","menu",false,"","Journal",{"type":10,"children":11,"toc":145},"root",[12,28,47,58,77,96,115,134],{"type":13,"tag":14,"props":15,"children":16},"element","fancy-quote",{},[17],{"type":13,"tag":18,"props":19,"children":20},"template",{"v-slot:sentence":7},[21],{"type":13,"tag":22,"props":23,"children":24},"p",{},[25],{"type":26,"value":27},"text","工作上的有序和纪律，正是需要生活中的无序和松弛来平衡。",{"type":13,"tag":14,"props":29,"children":30},{},[31,39],{"type":13,"tag":18,"props":32,"children":33},{"v-slot:sentence":7},[34],{"type":13,"tag":22,"props":35,"children":36},{},[37],{"type":26,"value":38},"没人能真正了解一个人，除非他能穿上他的鞋，走他走过的路。",{"type":13,"tag":18,"props":40,"children":41},{"v-slot:cite":7},[42],{"type":13,"tag":22,"props":43,"children":44},{},[45],{"type":26,"value":46},"— 《杀死一只知更鸟》",{"type":13,"tag":14,"props":48,"children":49},{},[50],{"type":13,"tag":18,"props":51,"children":52},{"v-slot:sentence":7},[53],{"type":13,"tag":22,"props":54,"children":55},{},[56],{"type":26,"value":57},"我们无法判断某个瞬间的价值，直到它成为回忆。",{"type":13,"tag":14,"props":59,"children":60},{},[61,69],{"type":13,"tag":18,"props":62,"children":63},{"v-slot:sentence":7},[64],{"type":13,"tag":22,"props":65,"children":66},{},[67],{"type":26,"value":68},"设计系统的架构受制于产生这些设计的组织的沟通结构。",{"type":13,"tag":18,"props":70,"children":71},{"v-slot:cite":7},[72],{"type":13,"tag":22,"props":73,"children":74},{},[75],{"type":26,"value":76},"― M. Conway",{"type":13,"tag":14,"props":78,"children":79},{},[80,88],{"type":13,"tag":18,"props":81,"children":82},{"v-slot:sentence":7},[83],{"type":13,"tag":22,"props":84,"children":85},{},[86],{"type":26,"value":87},"按照星星，而不是按照过往船只的灯光设定航向。",{"type":13,"tag":18,"props":89,"children":90},{"v-slot:cite":7},[91],{"type":13,"tag":22,"props":92,"children":93},