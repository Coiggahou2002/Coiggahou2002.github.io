e":15,"tag":59,"props":230,"children":231},{"style":93},[232],{"type":21,"value":96},{"type":15,"tag":59,"props":234,"children":235},{"style":82},[236],{"type":21,"value":101},{"type":15,"tag":238,"props":239,"children":240},"blockquote",{},[241],{"type":15,"tag":29,"props":242,"children":243},{},[244],{"type":21,"value":245},"其实第三种写法是最规范的，第二种写法是有隐患的，至于为什么先按下不表，在本文后面详细解释。",{"type":15,"tag":29,"props":247,"children":248},{},[249],{"type":21,"value":250},"在此之前，我们已经知道有这个写法规范的问题存在，但 Nuxt 3 框架在之前并不会因为这个问题而报错，为什么现在突然因为这个问题报错了呢？",{"type":15,"tag":29,"props":252,"children":253},{},[254],{"type":21,"value":255},"因为该项目近段时间刚升级过框架，第一想法是框架升级导致的，所以查原因的重点主要在以下几个方面：",{"type":15,"tag":257,"props":258,"children":259},"ol",{},[260,266],{"type":15,"tag":261,"props":262,"children":263},"li",{},[264],{"type":21,"value":265},"Nuxt 框架升级过程中，框架本身是否有 TS 相关的配置性变动？",{"type":15,"tag":261,"props":267,"children":268},{},[269],{"type":21,"value":270},"TS 相关的东西大部分都只存在于编译期，为什么 TS 类型的问题会导致抛出运行时错误？",{"type":15,"tag":23,"props":272,"children":274},{"id":273},"前置知识",[275],{"type":21,"value":273},{"type":15,"tag":277,"props":278,"children":280},"h3",{"id":279},"类型和值",[281],{"type":21,"value":279},{"type":15,"tag":29,"props":283,"children":284},{},[285,290,292,298,300,306,308,317,319,324,325,330,332,338,340,345,347,352],{"type":15,"tag":40,"props":286,"children":288},{"className":287},[],[289],{"type":21,"value":138},{"type":21,"value":291}," 和 ",{"type":15,"tag":40,"props":293,"children":295},{"className":294},[],[296],{"type":21,"value":297},"interface",{"type":21,"value":299}," 在 TypeScript 编译过程中一般会直接被删除，不会留在产物 JS 代码中, 而 ",{"type":15,"tag":40,"props":301,"children":303},{"className":302},[],[304],{"type":21,"value":305},"enum",{"type":21,"value":307}," 是会以",{"type":15,"tag":309,"props":310,"children":314},"a",{"href":311,"rel":312},"https://www.typescriptlang.org/docs/handbook/enums.html#reverse-mappings",[313],"nofollow",[315],{"type":21,"value":316},"双向 map 对象的形式",{"type":21,"value":318},"留在产物 JS 代码中，此中我们称 ",{"type":15,"tag":40,"props":320,"children":322},{"className":321},[],[323],{"type":21,"value":138},{"type":21,"value":291},{"type":15,"tag":40,"props":326,"children":328},{"className":327},[],[329],{"type":21,"value":297},{"type":21,"value":331}," 这种不产生 JS 代码产物的类型为",{"type":15,"tag":333,"props":334,"children":335},"strong",{},[336],{"type":21,"value":337},"纯类型",{"type":21,"value":339},"，把 ",{"type":15,"tag":40,"props":341,"children":343},{"className":342},[],[344],{"type":21,"value":305},{"type":21,"value":346}," 这种会产生 JS 代码产物的类型称为",{"type":15,"tag":333,"props":348,"children":349},{},[350],{"type":21,"value":351},"带值类型",{"type":21,"value":353},"。",{"type":15,"tag":29,"props":355,"children":356},{},[357,359,364,366,371,373,378],{"type":21,"value":358},"由于我们在下文中只关心它们",{"type":15,"tag":333,"props":360,"children":361},{},[362],{"type":21,"value":363},"是否产生 JS 产物",{"type":21,"value":365},"这项区别，所以我们把他们一个叫作",{"type":15,"tag":333,"props":367,"children":368},{},[369],{"type":21,"value":370},"类型",{"type":21,"value":372},"，一个叫作",{"type":15,"tag":333,"props":374,"children":375},{},[376],{"type":21,"value":377},"值",{"type":21,"value":353},{"type":15,"tag":277,"props":380,"children":382},{"id":381},"ts-转译器",[383],{"type":21,"value":384},"TS 转译器",{"type":15,"tag":29,"props":386,"children":387},{},[388,390,397,399,406,408,415,416,423],{"type":21,"value":389},"负责将 TS 转成 JS 的工具，有很多种，官方的工具是 ",{"type":15,"tag":309,"props":391,"children":394},{"href":392,"rel":393},"https://www.npmjs.com/package/typescript",[313],[395],{"type":21,"value":396},"typescript",{"type":21,"value":398},"（一般称为 tsc）, 此外还有 ",{"type":15,"tag":309,"props":400,"children":403},{"href":401,"rel":402},"https://babeljs.io/docs/babel-preset-typescript",[313],[404],{"type":21,"value":405},"Babel",{"type":21,"value":407},", ",{"type":15,"tag":309,"props":409,"children":412},{"href":410,"rel":411},"https://esbuild.github.io/content-types/#typescript",[313],[413],{"type":21,"value":414},"esbuild",{"type":21,"value":407},{"type":15,"tag":309,"props":417,"children":420},{"href":418,"rel":419},"https://swc.rs/",[313],[421],{"type":21,"value":422},"SWC",{"type":21,"value":424}," 等。",{"type":15,"tag":29,"props":426,"children":427},{},[428],{"type":21,"value":429},"这里简单介绍下 esbuild:",{"type":15,"tag":29,"props":431,"children":432},{},[433],{"type":21,"value":434},"它是一个用 golang 语言编写的打包器（bundler），能够将 TS 转为 JS，但并不会进行类型检查，需要额外运行类型检查器。不同于 tsc，它使用的是单文件转译模式。",{"type":15,"tag":238,"props":436,"children":437},{},[438],{"type":15,"tag":29,"props":439,"children":440},{},[441],{"type":21,"value":442},"单文件转译模式在下文会详细解释。",{"type":15,"tag":277,"props":444,"children":446},{"id":445},"缩写和简称的声明",[447],{"type":21,"value":445},{"type":15,"tag":29,"props":449,"children":450},{},[451],{"type":21,"value":452},"下文中均用 TS 代指 TypeScript，用 JS 代指 JavaScript，用 tsc 代指微软官方的 TypeScript 编译器。",{"type":15,"tag":23,"props":454,"children":456},{"id":455},"抛出运行时错误的原因分析",[457],{"type":21,"value":455},{"type":15,"tag":29,"props":459,"children":460},{},[461],{"type":21,"value":462},"要分析这一点，我们需要对 Nuxt 3 这个框架和 TypeScript 的编译行为有基本的了解。",{"type":15,"tag":29,"props":464,"children":465},{},[466,468,474,476,482,484,490],{"type":21,"value":467},"我们的运行时错误信息说明，项目在客户端运行时(Client Runtime)向 ",{"type":15,"tag":40,"props":469,"children":471},{"className":470},[],[472],{"type":21,"value":473},"@types/myTypes",{"type":21,"value":475}," 这个模块请求了 ",{"type":15,"tag":40,"props":477,"children":479},{"className":478},[],[480],{"type":21,"value":481},"SomeType",{"type":21,"value":483}," 这个值，但却没有拿到，这说明 ",{"type":15,"tag":40,"props":485,"children":487},{"className":486},[],[488],{"type":21,"value":489},"import { SomeType } from '@types/myTypes'",{"type":21,"value":491}," 这句话，被留到了打包后的 JS 产物中（因为运行时跑的肯定是转译后的 JS 而不是 TS）。",{"type":15,"tag":29,"props":493,"children":494},{},[495,497,502],{"type":21,"value":496},"但仔细一想，这句话其实不应该被留掉打包后的 JS 产物中，为什么呢？因为 ",{"type":15,"tag":40,"props":498,"children":500},{"className":499},[],[501],{"type":21,"value":481},{"type":21,"value":503}," 是一个纯类型，它并不为运行时提供任何值，只在编译时起作用，用来辅助类型检查器为写代码的人提供类型检查和类型提示，所以这句话应该在编译期被去除。",{"type":15,"tag":29,"props":505,"children":506},{},[507],{"type":21,"value":508},"为什么没有被去除呢？这个就是本文的重点了。",{"type":15,"tag":23,"props":510,"children":512},{"id":511},"编译器是怎么处理-import-语句的",[513],{"type":21,"value":514},"编译器是怎么处理 import 语句的？",{"type":15,"tag":29,"props":516,"children":517},{},[518],{"type":21,"value":519},"通常来说，我们在文件 A 中 import 文件 B 提供的东西，是为了使用模块化机制合理拆分代码，以及为了在 A 文件中使用 B 提供的某些东西。",{"type":15,"tag":521,"props":522,"children":523},"info",{},[524],{"type":15,"tag":29,"props":525,"children":526},{},[527],{"type":21,"value":528},"一般来说，如果我们安装了 lint 插件，对于那些 import 了但是没有使用的东西，lint 会提示 unused import，引导我们移除它们，但不排除格式化后的代码仍然有未使用的 import 存在",{"type":15,"tag":29,"props":530,"children":531},{},[532],{"type":21,"value":533},"通常来说，我们写的是 TS，但运行时跑的是 JS，TS 编译器要做一些工作将我们的 JS 转换成 TS。",{"type":15,"tag":29,"props":535,"children":536},{},[537],{"type":21,"value":538},"编译器在遇到 import 语句的时候，可能会做各种行为（包括解析模块引用、查找文件等），除此之外，编译器还需要决定每一条 import 语句的去留，面对这个问题（我们这里主要讨论这个问题），编译器可以做两个选择：",{"type":15,"tag":29,"props":540,"children":541},{},[542],{"type":15,"tag":333,"props":543,"children":544},{},[545],{"type":21,"value":546},"1. 移除这个 import 语句",{"type":15,"tag":548,"props":549,"children":550},"ul",{},[551,556],{"type":15,"tag":261,"props":552,"children":553},{},[554],{"type":21,"value":555},"如果编译器认为， import 的这个东西并没有在代码中被使用，当然要移除它",{"type":15,"tag":261,"props":557,"children":558},{},[559,561,567,569,574,576],{"type":21,"value":560},"如果编译器认为，import 的这个东西，是一个纯类型，编译器就应该把它移除，因为如果不移除，最后的 JS 代码里就会有 ",{"type":15,"tag":40,"props":562,"children":564},{"className":563},[],[565],{"type":21,"value":566},"import { SomeType } from '@/types/myTypes'",{"type":21,"value":568},"，但最后的 JS 代码里并不会有 ",{"type":15,"tag":40,"props":570,"children":572},{"className":571},[],[573],{"type":21,"value":481},{"type":21,"value":575},"（因为 TS 编译器会直接移除所有纯类型的声明），此时就会引发运行时的报错：",{"type":15,"tag":40,"props":577,"children":579},{"className":578},[],[580],{"type":21,"value":581},"SyntaxError: The requested module 'myTypes' does not provide an export named 'SomeType'",{"type":15,"tag":29,"props":583,"children":584},{},[585],{"type":15,"tag":333,"props":586,"children":587},{},[588],{"type":21,"value":589},"2. 留下这个 import 语句",{"type":15,"tag":548,"props":591,"children":592},{},[593],{"type":15,"tag":261,"props":594,"children":595},{},[596],{"type":21,"value":597},"这个最简单，当编译器不确定一条语句是否能够被移除时，他就会保留",{"type":15,"tag":599,"props":600,"children":601},"hr",{},[],{"type":15,"tag":29,"props":603,"children":604},{},[605],{"type":15,"tag":333,"props":606,"children":607},{},[608],{"type":21,"value":609},"那么问题又来了：",{"type":15,"tag":548,"props":611,"children":612},{},[613,618],{"type":15,"tag":261,"props":614,"children":615},{},[616],{"type":21,"value":617},"第一个问题，编译器如何判定import的东西是否在代码中被使用？",{"type":15,"tag":261,"props":619,"children":620},{},[621],{"type":21,"value":622},"第二个问题，编译器如何知道你 import 的东西是一个纯类型，还是一个值？",{"type":15,"tag":277,"props":624,"children":626},{"id":625},"如何判定-import-的东西是否在代码中被使用",[627],{"type":21,"value":628},"如何判定 import 的东西是否在代码中被使用？",{"type":15,"tag":29,"props":630,"children":631},{},[632],{"type":21,"value":633},"这个一般通过语法分析就可以实现，几乎所有代码编译的第二步（第一步是将字符串根据关键字和特定符号切分成 tokens）都是将 tokens 列表转换为 AST（Abstract Syntax Tree，抽象语法树），编译器会遍历 AST 和符号表，检查是否有对导入模块的成员进行引用。如果一个成员在代码中被引用，它就会被标记为“已使用”。",{"type":15,"tag":29,"props":635,"children":636},{},[637,639,645],{"type":21,"value":638},"当然，也有编译器判定不了的特殊情况，例如被 ",{"type":15,"tag":40,"props":640,"children":642},{"className":641},[],[643],{"type":21,"value":644},"eval()",{"type":21,"value":646}," 包裹的代码字符串，里面是一个字符串字面量，但实际意义却是代码，但编译器只是将其识别为了字符串字面量，并没有转换成AST，所以是漏网之鱼。",{"type":15,"tag":49,"props":648,"children":650},{"className":51,"code":649,"language":53,"meta":7,"style":7},"// 编译器会认为你并没有使用到 Animal 这个东西\n\nimport { Animal } from './animals'\n\neval('let b = new Animal()');\n",[651],{"type":15,"tag":40,"props":652,"children":653},{"__ignoreMap":7},[654,662,669,690,697],{"type":15,"tag":59,"props":655,"children":656},{"class":61,"line":62},[657],{"type":15,"tag":59,"props":658,"children":659},{"style":66},[660],{"type":21,"value":661},"// 编译器会认为你并没有使用到 Animal 这个东西\n",{"type":15,"tag":59,"props":663,"children":664},{"class":61,"line":72},[665],{"type":15,"tag":59,"props":666,"children":667},{"emptyLinePlaceholder":108},[668],{"type":21,"value":111},{"type":15,"tag":59,"props":670,"children":671},{"class":61,"line":104},[672,676,681,685],{"type":15,"tag":59,"props":673,"children":674},{"style":76},[675],{"type":21,"value":79},{"type":15,"tag":59,"props":677,"children":678},{"style":82},[679],{"type":21,"value":680}," { Animal } ",{"type":15,"tag":59,"props":682,"children":683},{"style":76},[684],{"type":21,"value":90},{"type":15,"tag":59,"props":686,"children":687},{"style":93},[688],{"type":21,"value":689}," './animals'\n",{"type":15,"tag":59,"props":691,"children":692},{"class":61,"line":114},[693],{"type":15,"tag":59,"props":694,"children":695},{"emptyLinePlaceholder":108},[696],{"type":21,"value":111},{"type":15,"tag":59,"props":698,"children":699},{"class":61,"line":123},[700,706,711,716],{"type":15,"tag":59,"props":701,"children":703},{"style":702},"--shiki-default:#6F42C1;--shiki-dark:#B392F0;--shiki-sepia:#A6E22E",[704],{"type":21,"value":705},"eval",{"type":15,"tag":59,"props":707,"children":708},{"style":82},[709],{"type":21,"value":710},"(",{"type":15,"tag":59,"props":712,"children":713},{"style":93},[714],{"type":21,"value":715},"'let b = new Animal()'",{"type":15,"tag":59,"props":717,"children":718},{"style":82},[719],{"type":21,"value":720},");\n",{"type":15,"tag":277,"props":722,"children":724},{"id":723},"如何判断-import-的东西是类型还是值",[725],{"type":21,"value":726},"如何判断 import 的东西是类型还是值？",{"type":15,"tag":29,"props":728,"children":729},{},[730],{"type":21,"value":731},"第一种情况，如果你显式声明了引用的是类型，编译器就不用猜了;",{"type":15,"tag":29,"props":733,"children":734},{},[735],{"type":21,"value":736},"第二种情况，如果你并没有显式声明 import 的是类型还是值...",{"type":15,"tag":49,"props":738,"children":740},{"className":51,"code":739,"language":53,"meta":7,"style":7},"// 显式声明引用的是一个类型而不是值，编译器就不用猜了，直接移除这一行\nimport type { SomeInterface } from './types'\n\n// 没有显式声明，而且类型和值混在一起，编译器需要逐个判断是否能去除\nimport { SomeInterface, SomeEnum } from './types'\n",[741],{"type":15,"tag":40,"props":742,"children":743},{"__ignoreMap":7},[744,752,777,784,792],{"type":15,"tag":59,"props":745,"children":746},{"class":61,"line":62},[747],{"type":15,"tag":59,"props":748,"children":749},{"style":66},[750],{"type":21,"value":751},"// 显式声明引用的是一个类型而不是值，编译器就不用猜了，直接移除这一行\n",{"type":15,"tag":59,"props":753,"children":754},{"class":61,"line":72},[755,759,763,768,772],{"type":15,"tag":59,"props":756,"children":757},{"style":76},[758],{"type":21,"value":79},{"type":15,"tag":59,"props":760,"children":761},{"style":76},[762],{"type":21,"value":194},{"type":15,"tag":59,"props":764,"children":765},{"style":82},[766],{"type":21,"value":767}," { SomeInterface } ",{"type":15,"tag":59,"props":769,"children":770},{"style":76},[771],{"type":21,"value":90},{"type":15,"tag":59,"props":773,"children":774},{"style":93},[775],{"type":21,"value":776}," './types'\n",{"type":15,"tag":59,"props":778,"children":779},{"class":61,"line":104},[780],{"type":15,"tag":59,"props":781,"children":782},{"emptyLinePlaceholder":108},[783],{"type":21,"value":111},{"type":15,"tag":59,"props":785,"children":786},{"class":61,"line":114},[787],{"type":15,"tag":59,"props":788,"children":789},{"style":66},[790],{"type":21,"value":791},"// 没有显式声明，而且类型和值混在一起，编译器需要逐个判断是否能去除\n",{"type":15,"tag":59,"props":793,"children":794},{"class":61,"line":123},[795,799,804,808],{"type":15,"tag":59,"props":796,"children":797},{"style":76},[798],{"type":21,"value":79},{"type":15,"tag":59,"props":800,"children":801},{"style":82},[802],{"type":21,"value":803}," { SomeInterface, SomeEnum } ",{"type":15,"tag":59,"props":805,"children":806},{"style":76},[807],{"type":21,"value":90},{"type":15,"tag":59,"props":809,"children":810},{"style":93},[811],{"type":21,"value":776},{"type":15,"tag":29,"props":813,"children":814},{},[815],{"type":21,"value":816},"具体来说，编译器是这样判断的：",{"type":15,"tag":548,"props":818,"children":819},{},[820,841],{"type":15,"tag":261,"props":821,"children":822},{},[823,825,831,833,839],{"type":21,"value":824},"对于 tsc 来说，它有办法利用多个文件蕴含的整个类型系统的信息，来发现你这个 ",{"type":15,"tag":40,"props":826,"children":828},{"className":827},[],[829],{"type":21,"value":830},"SomeInterface",{"type":21,"value":832}," 指代的是一个类型，而 ",{"type":15,"tag":40,"props":834,"children":836},{"className":835},[],[837],{"type":21,"value":838},"SomeEnum",{"type":21,"value":840}," 是一个值，它就会去除掉 SomeInterface，但保留 SomeEnum 的引入语句",{"type":15,"tag":261,"props":842,"children":843},{},[844,846,867],{"type":21,"value":845},"对于 tsc 以外的 TypeScript 编译器来说，就不一定了——例如 Babel 的 TS 转译器和 esbuild 都是单文件转译的模式，他们不像 tsc 一样具备在整个类型系统信息的背景下转译这个文件的能力，所以",{"type":15,"tag":333,"props":847,"children":848},{},[849,851,857,859,865],{"type":21,"value":850},"在某些情况下，他们没办法判断一个 ",{"type":15,"tag":40,"props":852,"children":854},{"className":853},[],[855],{"type":21,"value":856},"import A",{"type":21,"value":858}," 的 ",{"type":15,"tag":40,"props":860,"children":862},{"className":861},[],[863],{"type":21,"value":864},"A",{"type":21,"value":866}," 到底是不是一个纯类型",{"type":21,"value":868},"，那么此时编译器就并不能肯定地认为这个语句能够去掉，于是就会保留它。",{"type":15,"tag":29,"props":870,"children":871},{},[872,874,881,883,890,892,899],{"type":21,"value":873},"这种被错误保留的语句，它们引用了在编译时已经被去除的类型声明，也就是在运行时引用了一个不存在的值，所以这种情况一般会引发一些 bug 或者运行时错误（这一点在 ",{"type":15,"tag":309,"props":875,"children":878},{"href":876,"rel":877},"https://www.typescriptlang.org/tsconfig/#isolatedModules",[313],[879],{"type":21,"value":880},"TypeScript 官方文档",{"type":21,"value":882},"和 ",{"type":15,"tag":309,"props":884,"children":887},{"href":885,"rel":886},"https://github.com/evanw/esbuild/issues/314#issuecomment-668401819",[313],[888],{"type":21,"value":889},"Evan Wallance 的回复",{"type":21,"value":891},"，以及 ",{"type":15,"tag":309,"props":893,"children":896},{"href":894,"rel":895},"https://esbuild.github.io/content-types/#isolated-modules",[313],[897],{"type":21,"value":898},"esbuild 的文档",{"type":21,"value":900},"中都有说明）",{"type":15,"tag":29,"props":902,"children":903},{},[904,910],{"type":15,"tag":309,"props":905,"children":907},{"href":876,"rel":906},[313],[908],{"type":21,"value":909},"TypeScript 官方文档关于单文件转译模式的说明原话",{"type":21,"value":911},"如下：",{"type":15,"tag":238,"props":913,"children":914},{},[915],{"type":15,"tag":29,"props":916,"children":917},{},[918],{"type":21,"value":919},"While you can use TypeScript to produce JavaScript code from TypeScript code, it’s also common to use other transpilers such as Babel to do this. However, other transpilers only operate on a single file at a time, which means they can’t apply code transforms that depend on understanding the full type system. This restriction also applies to TypeScript’s ts.transpileModule API which is used by some build tools.",{"type":15,"tag":29,"props":921,"children":922},{},[923],{"type":21,"value":924},"回到前面铺垫的 esbuild，它是单文件转译模式，也就意味着它无法像 tsc 那样在转译时拥有整个类型系统的信息（但是它快啊！在转译同样代码量的 TS 项目时，不需要关心太多上下文的 esbuild 比 tsc 快很多倍）",{"type":15,"tag":29,"props":926,"children":927},{},[928,933],{"type":15,"tag":333,"props":929,"children":930},{},[931],{"type":21,"value":932},"题外话：",{"type":21,"value":934}," 这里恰好解释了为什么 Vite 在开发模式选用了 esbuild 来做 TS 的转译，因为这刚好符合 Vite 的「不打包、对浏览器按需提供文件」的模式",{"type":15,"tag":29,"props":936,"children":937},{},[938,945],{"type":15,"tag":309,"props":939,"children":942},{"href":940,"rel":941},"https://vitejs.dev/guide/features.html#transpile-only",[313],[943],{"type":21,"value":944},"Vite 官方文档的原话",{"type":21,"value":946},"为：",{"type":15,"tag":238,"props":948,"children":949},{},[950],{"type":15,"tag":29,"props":951,"children":952},{},[953],{"type":21,"value":954},"The reason Vite does not perform type checking as part of the transform process is because the two jobs work fundamentally differently. Transpilation can work on a per-file basis and aligns perfectly with Vite's on-demand compile model. In comparison, type checking requires knowledge of the entire module graph. Shoe-horning type checking into Vite's transform pipeline will inevitably compromise Vite's speed benefits.",{"type":15,"tag":23,"props":956,"children":958},{"id":957},"ts-的相关配置",[959],{"type":21,"value":960},"TS 的相关配置",{"type":15,"tag":29,"props":962,"children":963},{},[964],{"type":21,"value":965},"TODO: 这里讲一下每个配置有什么作用",{"type":15,"tag":548,"props":967,"children":968},{},[969,974,979,984],{"type":15,"tag":261,"props":970,"children":971},{},[972],{"type":21,"value":973},"isolatedModules: 为了让用单文件的编译器的用户，也能及时爆出一些错误",{"type":15,"tag":261,"props":975,"children":976},{},[977],{"type":21,"value":978},"importsNotUsedAsValues: 规定那些没有用到的 import 值应该怎么处理，remove/perserve/error",{"type":15,"tag":261,"props":980,"children":981},{},[982],{"type":21,"value":983},"preserveValueImports",{"type":15,"tag":261,"props":985,"children":986},{},[987],{"type":21,"value":988},"verbatimModuleSyntax",{"type":15,"tag":23,"props":990,"children":992},{"id":991},"其他信息",[993],{"type":21,"value":991},{"type":15,"tag":548,"props":995,"children":996},{},[997,1002,1007,1012,1017],{"type":15,"tag":261,"props":998,"children":999},{},[1000],{"type":21,"value":1001},"Vite 5.3.1 之前，生产打包用的是 @rollup/plugin-typescript, 之后换成了 esbuild",{"type":15,"tag":261,"props":1003,"children":1004},{},[1005],{"type":21,"value":1006},"Nuxt 3.7 发布的时候带上了 isolatedModules = true",{"type":15,"tag":261,"props":1008,"children":1009},{},[1010],{"type":21,"value":1011},"Nuxt 3.8 发布带上了 verbatimModuleSyntax = true",{"type":15,"tag":261,"props":1013,"children":1014},{},[1015],{"type":21,"value":1016},"项目用的是 Nuxt 3.11 + Vite 4.5.3 + Rollup 3.2.9",{"type":15,"tag":261,"props":1018,"children":1019},{},[1020],{"type":21,"value":1021},"那个type错误其实只有dev环境有，因为目前项目这个版本的 Nuxt 的vite在dev模式用的esbuild，生产打包还是tsc，所以生产没事，生产500是因为bridge的问题",{"type":15,"tag":29,"props":1023,"children":1024},{},[1025],{"type":21,"value":1026},"