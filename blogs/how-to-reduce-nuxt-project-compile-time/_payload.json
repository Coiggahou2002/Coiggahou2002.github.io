[{"data":1,"prerenderedAt":109},["Reactive",2],{"content-query-ue1nXV0rXF":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"time":9,"body":10,"_type":104,"_id":105,"_source":106,"_file":107,"_extension":108},"/blogs/how-to-reduce-nuxt-project-compile-time","blogs",false,"","如何缩短前端项目构建时间","2025-06-08T00:00:00.000Z",{"type":11,"children":12,"toc":99},"root",[13,21,74],{"type":14,"tag":15,"props":16,"children":18},"element","h2",{"id":17},"核心思路",[19],{"type":20,"value":17},"text",{"type":14,"tag":22,"props":23,"children":24},"ul",{},[25,31,36,41,55],{"type":14,"tag":26,"props":27,"children":28},"li",{},[29],{"type":20,"value":30},"构建的步骤不要放在 Dockerfile 里",{"type":14,"tag":26,"props":32,"children":33},{},[34],{"type":20,"value":35},"Dockerfile 只负责构建运行时镜像",{"type":14,"tag":26,"props":37,"children":38},{},[39],{"type":20,"value":40},"缓存 node_modules, 不要每次都安装，当 package.json 没有发生变化时复用",{"type":14,"tag":26,"props":42,"children":43},{},[44,46,53],{"type":20,"value":45},"使用 ",{"type":14,"tag":47,"props":48,"children":50},"code",{"className":49},[],[51],{"type":20,"value":52},"npm prune --production",{"type":20,"value":54}," 删掉 devDependencies，能有效缩减一半以上的镜像体积",{"type":14,"tag":26,"props":56,"children":57},{},[58,60,66,68],{"type":20,"value":59},"镜像基础层尽量使用瘦身版本的，例如 ",{"type":14,"tag":47,"props":61,"children":63},{"className":62},[],[64],{"type":20,"value":65},"node:20-slim",{"type":20,"value":67},"，如果连 npm 都不需要（指在 Dockerfile 里用不上 npm），可以用更小的 ",{"type":14,"tag":47,"props":69,"children":71},{"className":70},[],[72],{"type":20,"value":73},"node:20-alpine",{"type":14,"tag":75,"props":76,"children":77},"info",{},[78],{"type":14,"tag":79,"props":80,"children":81},"p",{},[82,84,90,92,97],{"type":20,"value":83},"其实明明可以安装的时候直接 ",{"type":14,"tag":47,"props":85,"children":87},{"className":86},[],[88],{"type":20,"value":89},"npm i --production",{"type":20,"value":91}," 来跳过 devDependencies，为什么要装了之后又删掉呢？因为多数情况下，build 的步骤是需要 devDependencies 的（例如各种 TS 类型的包），bui