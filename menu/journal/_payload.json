[{"data":1,"prerenderedAt":119},["Reactive",2],{"content-query-ebkoD7DmVJ":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"body":9,"_type":114,"_id":115,"_source":116,"_file":117,"_extension":118},"/menu/journal","menu",false,"","Journal",{"type":10,"children":11,"toc":110},"root",[12,42,61,80,99],{"type":13,"tag":14,"props":15,"children":16},"element","fancy-quote",{},[17,34],{"type":13,"tag":18,"props":19,"children":20},"template",{"v-slot:sentence":7},[21],{"type":13,"tag":22,"props":23,"children":24},"p",{},[25,32],{"type":13,"tag":26,"props":27,"children":28},"span",{},[29],{"type":30,"value":31},"text","O",{"type":30,"value":33},"rganizations which design systems (in the broad sense used here) are constrained to produce designs which are copies of the communication structures of these organizations.",{"type":13,"tag":18,"props":35,"children":36},{"v-slot:cite":7},[37],{"type":13,"tag":22,"props":38,"children":39},{},[40],{"type":30,"value":41},"― M. Conway",{"type":13,"tag":14,"props":43,"children":44},{},[45,53],{"type":13,"tag":18,"props":46,"children":47},{"v-slot:sentence":7},[48],{"type":13,"tag":22,"props":49,"children":50},{},[51],{"type":30,"value":52},"Set your course by the stars, not by the lights of passing ships.",{"type":13,"tag":18,"props":54,"children":55},{"v-slot:cite":7},[56],{"type":13,"tag":22,"props":57,"children":58},{},[59],{"type":30,"value":60},"— Omar Bradley",{"type":13,"tag":14,"props":62,"children":63},{},[64,72],{"type":13,"tag":18,"props":65,"children":66},{"v-slot:sentence":7},[67],{"type":13,"tag":22,"props":68,"children":69},{},[70],{"type":30,"value":71},"Improving yourself is better than proving yourself.",{"type":13,"tag":18,"props":73,"children":74},{"v-slot:cite":7},[75],{"type":13,"tag":22,"props":76,"children":77},{},[78],{"type":30,"value":79},"— Tiesheng Shi",{"type":13,"tag":14,"props":81,"children":82},{},[83,91],{"type":13,"tag":18,"props":84,"children":85},{"v-slot:sentence":7},[86],{"type":13,"tag":22,"props":87,"children":88},{},[89],{"type":30,"value":90},"When I cannot create, I do not understand.",{"type":13,"tag":18,"props":92,"children":93},{"v-slot:cite":7},[94],{"type":13,"tag":22,"props":95,"children":96},{},[97],{"type":30,"value":98},"— Richard Phillips Feynman",{"type":13,"tag":14,"props":100,"children":101},{},[102],{"type":13,"tag":18,"props":103,"children":104},{"v-slot:sentence":7},[105],{"type":13,"tag":22,"props":106,"children":107},{},[108],{"type":30,"value":109},"It is a good thing to have limited conditions, because limited conditions allow you to make more use of your small material, so that you can no longer use brute force to complete the work, and you must think about using knowledge-intensive solutions to solve problems more intelligently.",{"title":7,"searchDepth":111,"depth":112,"links":113},3,2,[],"markdown","content:menu:journal.md","content","menu/journal.md","md",1790679919010]